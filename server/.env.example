# Price data: yahoo (default, no key), alphavantage (needs ALPHAVANTAGE_KEY) or demo (offline, simulated)
DATA_PROVIDER=yahoo
ALPHAVANTAGE_KEY=

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Any long random text. Required when NODE_ENV=production.
JWT_SECRET=change-this-to-any-long-random-text

# Optional. Leave empty to use in-memory storage, cache and jobs.
DATABASE_URL=
REDIS_URL=

# Optional. Razorpay keys (Dashboard → Settings → API Keys). Use rzp_test_ keys for test mode.
# Leave empty to use the free demo upgrade.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PRO_PRICE_PAISE=39900

# Optional. For price-alert emails (e.g. Gmail: smtp.gmail.com, 587, app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=QuantLens <alerts@quantlens.local>
